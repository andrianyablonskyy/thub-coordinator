extends ../layout
include ../mixins/updates
include ../mixins/group-select
include ../mixins/list-controls

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.h4.mb-0 CI tokens
    button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#addAgentModal") New CI token
  .d-flex.flex-wrap.align-items-center.gap-2.mb-3
    +updatesToolbar('agent', 'agents', list.pageUrl())
  .d-flex.flex-wrap.align-items-center.gap-2.mb-3
    +searchForm(q, 'Search CI tokens: name, group, version, status', list.urlFor({ q: '' }))
    .ms-auto
      +pageSizePicker(list)

  if newToken
    //- Shown once: nothing below keeps it.
    .alert.alert-warning(role="alert")
      strong= newTokenFor ? `New token for ${newTokenFor} (shown once — the old one has stopped working):` : 'Token (shown once):'
      .input-group.input-group-sm.mt-2
        input.form-control.font-monospace(type="text" value=newToken readonly aria-label="Token")
        button.btn.btn-outline-secondary(type="button" data-copy=newToken aria-label="Copy token")
          i.bi.bi-clipboard

  div(data-live="list-toolbar")
    +listToolbar(list, 'agents')

  table.table.table-hover.align-middle
    thead
      tr
        +sortHeader(list, 'name', 'Name')
        +sortHeader(list, 'group', 'Group')
        +sortHeader(list, 'version', 'Version', 'desc')
        +sortHeader(list, 'created', 'Created', 'desc')
        +sortHeader(list, 'used', 'Last used', 'desc')
        +sortHeader(list, 'status', 'Status')
        th
    tbody(data-live="rows")
      each a in agents
        tr(class=a.revoked_at ? 'opacity-50' : '')
          //- The name opens Edit (name and group).
          td
            a.fw-medium(href=`#editAgentModal-${a.id}` data-bs-toggle="modal" role="button")= a.name
          td
            if a.group_id && groupsById[a.group_id]
              span.badge.text-bg-info= groupsById[a.group_id].name
            else
              span.text-body-secondary any
          //- A revoked token can't pick an update up: no button.
          td: +versionWithUpdate(a.version, updates.latest.agent, a.update_to, `/admin/agents/${a.id}/update`, list.pageUrl(), !a.revoked_at)
          td= fmtDate(a.created_at)
          td= fmtDate(a.last_used_at, 'never')
          td= a.revoked_at ? 'revoked' : 'active'
          td
            .d-flex.justify-content-end.text-nowrap
              form(
                method="post"
                action=`/admin/agents/${a.id}/token`
                data-confirm=a.revoked_at ? `Issue a new token for "${a.name}"? It becomes active again with it.` : `Issue a new token for "${a.name}"? Its current token stops working at once — update it wherever it's used (a CI secret).`
                data-confirm-title="Issue a new token?"
                data-confirm-ok="Issue token"
                data-confirm-tone="primary"
              )
                input(type="hidden" name="returnTo" value=list.pageUrl())
                button.btn.btn-sm.btn-outline-primary(type="submit" aria-label=`New token for ${a.name}` data-bs-toggle="tooltip" data-bs-title="Issue a new token (the old one stops working; shown once)")
                  i.bi.bi-key
              if !a.revoked_at
                form.ms-1(
                  method="post"
                  action=`/admin/agents/${a.id}/revoke`
                  data-confirm=`Revoke the token of agent "${a.name}"? Everything using it — a CI pipeline, a developer's thub — gets 401 from then on. This cannot be undone.`
                  data-confirm-title="Revoke agent token?"
                  data-confirm-ok="Revoke"
                )
                  input(type="hidden" name="returnTo" value=list.pageUrl())
                  button.btn.btn-sm.btn-outline-warning(type="submit" aria-label=`Revoke ${a.name}` data-bs-toggle="tooltip" data-bs-title="Revoke the token (a new one can be issued later)")
                    i.bi.bi-key-fill
              form.ms-1(
                method="post"
                action=`/admin/agents/${a.id}/delete`
                data-confirm=`Delete CI token "${a.name}"? Its token stops working and it leaves this list for good; its jobs stay, listed under its name.`
                data-confirm-title="Delete CI token?"
                data-confirm-ok="Delete"
              )
                input(type="hidden" name="returnTo" value=list.pageUrl())
                button.btn.btn-sm.btn-outline-danger(type="submit" aria-label=`Delete ${a.name}` data-bs-toggle="tooltip" data-bs-title="Delete the CI token")
                  i.bi.bi-trash

      else
        tr
          td.text-body-secondary(colspan="7")
            if q
              | No agent matches “#{q}”. 
              a(href=list.urlFor({ q: '' })) Show all agents
            else
              | No agents yet.

  //- Edit windows: outside the table, which scrolls sideways in its own
  //- box on phones and would trap them under what follows.
  each a in agents
    .modal(tabindex="-1" id=`editAgentModal-${a.id}` aria-labelledby=`editAgentTitle-${a.id}`)
      .modal-dialog
        .modal-content
          form(method="post" action=`/admin/agents/${a.id}/rename`)
            input(type="hidden" name="returnTo" value=list.pageUrl())
            .modal-header
              h5.modal-title(id=`editAgentTitle-${a.id}`) Edit agent
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-body
              label.form-label(for=`agentName-${a.id}`) Name
              input.form-control(id=`agentName-${a.id}` type="text" name="name" value=a.name required maxlength="100")
              .form-text Only a label — the agent's token, and everything using it, keep working.
              label.form-label.mt-3(for=`agentGroup-${a.id}`) Group
              +groupSelect(`agentGroup-${a.id}`, a.group_id, groups)
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
              button.btn.btn-primary(type="submit") Save

  .modal(tabindex="-1" id="addAgentModal")
    .modal-dialog
      .modal-content
        form(method="post" action="/admin/agents")
          .modal-header
            h5.modal-title New CI token
            button.btn-close(type="button" data-bs-dismiss="modal")
          .modal-body
            .mb-3
              label.form-label Name
              input.form-control(type="text" name="name" placeholder="ci-firmware" required)
            .mb-3
              label.form-label(for="newAgentGroup") Group
              +groupSelect('newAgentGroup', null, groups)
            .mb-3
              p.small.text-body-secondary.mb-0.
                For a pipeline: its jobs get A- ids and it can read every job. People use their own access key
                instead (#[a(href="/admin/users") Users]).
          .modal-footer
            button.btn.btn-primary(type="submit") Create
