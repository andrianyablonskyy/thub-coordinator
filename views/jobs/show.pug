extends ../layout
include ../mixins/status-badge
include ../mixins/log-viewer

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.h4.mb-0
      = job.id
      |
      +jobBadge(job.state)(class="thub-heading-badge ms-1")
    if canCancel
      form(
        method="post"
        action=`/jobs/${job.id}/cancel`
        data-confirm=`Cancel job ${job.id}? It ends as CANCELED; if it's running, its Client stops it.`
        data-confirm-title="Cancel job?"
        data-confirm-ok="Cancel job"
        data-confirm-dismiss="Keep it"
      )
        button.btn.btn-outline-danger.btn-sm(type="submit") Cancel

  if waitingReason
    .alert.alert-warning.py-2.small
      i.bi.bi-hourglass-split.me-1
      | Waiting: #{waitingReason}
  dl.row
    dt.col-sm-2 Source
    dd.col-sm-10.text-uppercase= job.source
    if job.spec.user
      dt.col-sm-2 User
      dd.col-sm-10= job.spec.user
    dt.col-sm-2 Resource
    dd.col-sm-10= job.resource ? job.resource.name : job.resource_name ? `${job.resource_name} (removed)` : '—'
    dt.col-sm-2 Target
    dd.col-sm-10= `${job.spec.target.type} — ${(job.spec.target.labels || []).join(', ')}`
    if job.spec.target.group
      //- The submitting agent's group (set on the dashboard), by name.
      dt.col-sm-2 Group
      dd.col-sm-10= targetGroup ? targetGroup.name : '(a deleted group)'
    if job.spec.target.client
      dt.col-sm-2 Client
      dd.col-sm-10= pinnedClient ? pinnedClient.name : job.spec.target.client
    if job.spec.env && Object.keys(job.spec.env).length
      dt.col-sm-2 Environment
      dd.col-sm-10.font-monospace(data-bs-toggle="tooltip" data-bs-title="Set by --env; values are only given to the Client that runs the job")
        = Object.keys(job.spec.env).join(', ')
    dt.col-sm-2 Created
    dd.col-sm-10= fmtDate(job.created_at)
    if job.duration_sec != null
      dt.col-sm-2 Duration
      dd.col-sm-10(data-bs-toggle="tooltip" data-bs-title=`Finished ${fmtDate(job.finished_at)}`)= fmtDuration(job.duration_sec * 1000)
    if job.message
      dt.col-sm-2 Message
      dd.col-sm-10= job.message

  //- What the job published elsewhere and listed in $THUB_ARTIFACTS_FILE
  //- (README §7.3): metadata only; the links go to wherever the files are.
  h2.h6.mt-4#artifacts Artifacts
  if job.artifacts.length
    .table-responsive
      table.table.table-sm.align-middle.mb-0
        thead
          tr
            th Name
            th.text-end Size
            th Time
            th
        tbody
          each a in job.artifacts
            tr
              td
                a(href=a.link target="_blank" rel="noopener noreferrer")= a.name
              td.text-end.text-nowrap(title=a.size != null ? `${a.size} bytes` : null)= a.size != null ? fmtBytes(a.size) : '—'
              td.text-nowrap= a.timestamp ? fmtDate(a.timestamp) : '—'
              td.text-end
                a.btn.btn-sm.btn-outline-secondary(
                  href=a.link
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label=`Download ${a.name}`
                  data-bs-toggle="tooltip"
                  data-bs-title=a.link
                )
                  i.bi.bi-download
  else if jobActive
    p.small.text-body-secondary.mb-0 Listed here when the job finishes, if it reports any.
  else
    p.small.text-body-secondary.mb-0.
      None reported. A job lists the files it published (to Artifactory, S3, a file server…) in
      #[code $THUB_ARTIFACTS_FILE] as #[code [{"name", "size", "link", "timestamp"}]].

  h2.h6.mt-4 Log
  +logViewer(job.id, jobActive)
