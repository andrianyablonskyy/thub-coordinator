extends ../layout
include ../mixins/status-badge

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.h4.mb-0 Jobs
    if canManage
      .btn-group
        form(method="post" action="/jobs/reset-queue" onsubmit="return confirm('Cancel every queued/assigned/preparing/running job? This stops in-flight work.')")
          button.btn.btn-sm.btn-outline-warning(type="submit") Reset queue
        form.ms-1(method="post" action="/jobs/clean-history" onsubmit="return confirm('Permanently delete all finished jobs and their logs/artifacts? This cannot be undone.')")
          button.btn.btn-sm.btn-outline-danger(type="submit") Clean history

  form.row.g-2.mb-3(method="get")
    .col-auto
      select.form-select.form-select-sm(name="state" onchange="this.form.submit()")
        option(value="") any state
        each s in ['QUEUED','ASSIGNED','PREPARING','RUNNING','PASSED','FAILED','ERROR','TIMEOUT','CANCELED','LOST']
          option(value=s selected=filters.state === s)= s
    .col-auto
      select.form-select.form-select-sm(name="source" onchange="this.form.submit()")
        option(value="") any source
        option(value="ci" selected=filters.source === 'ci') ci
        option(value="cli" selected=filters.source === 'cli') cli

  table.table.table-hover.align-middle
    thead
      tr
        th Job
        th Source
        th User
        th State
        th Resource
        th Created
        th Finished
        if canManage
          th
    tbody
      each j in jobs
        tr
          td: a(href=`/jobs/${j.id}`)= j.id
          td.text-uppercase= j.source
          td= j.spec.user || '—'
          td: +jobBadge(j.state)
          td= j.resource ? j.resource.name : j.resource_name ? `${j.resource_name} (removed)` : '—'
          td= fmtDate(j.created_at)
          td= fmtDate(j.finished_at)
          if canManage
            td.text-end
              if j.active
                form.d-inline(
                  method="post"
                  action=`/jobs/${j.id}/cancel`
                  data-confirm=`Cancel job ${j.id}?`
                  onsubmit="return confirm(this.dataset.confirm)"
                )
                  input(type="hidden" name="returnTo" value=`/jobs${filterQuery}`)
                  button.btn.btn-sm.btn-outline-danger(type="submit" aria-label="Cancel" title="Cancel this job")
                    i.bi.bi-x-circle
