extends ../layout
include ../mixins/status-badge
include ../mixins/list-controls
include ../mixins/confirm-modal

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.h4.mb-0 Jobs
    if canManage
      .btn-group
        button.btn.btn-sm.btn-outline-warning(type="button" data-bs-toggle="modal" data-bs-target="#reset-queue-modal") Reset queue
        button.btn.btn-sm.btn-outline-danger.ms-1(type="button" data-bs-toggle="modal" data-bs-target="#clean-history-modal") Clean up database

  form.row.g-2.mb-3(method="get")
    .col-auto
      select.form-select.form-select-sm(name="state" onchange="this.form.submit()")
        option(value="") any state
        each s in ['QUEUED','ASSIGNED','PREPARING','RUNNING','PASSED','FAILED','ERROR','TIMEOUT','CANCELED','LOST']
          option(value=s selected=filters.state === s)= s
    .col-auto
      select.form-select.form-select-sm(name="source" onchange="this.form.submit()")
        option(value="") any source
        option(value="ci" selected=filters.source === 'ci') ci
        option(value="cli" selected=filters.source === 'cli') cli
    .col-auto.ms-auto
      +pageSizePicker(list)

  +listToolbar(list, 'jobs')

  table.table.table-hover.align-middle
    thead
      tr
        +sortHeader(list, 'id', 'Job')
        +sortHeader(list, 'source', 'Source')
        +sortHeader(list, 'user', 'User')
        +sortHeader(list, 'state', 'State')
        +sortHeader(list, 'resource', 'Resource')
        +sortHeader(list, 'created', 'Created', 'desc')
        +sortHeader(list, 'duration', 'Duration', 'desc')
        if canManage
          th
    tbody
      each j in jobs
        tr
          td: a(href=`/jobs/${j.id}`)= j.id
          td.text-uppercase= j.source
          td= j.spec.user || '—'
          td: +jobBadge(j.state)
          td= j.resource ? j.resource.name : j.resource_name ? `${j.resource_name} (removed)` : '—'
          td= fmtDate(j.created_at)
          td(data-bs-toggle=j.finished_at ? 'tooltip' : null data-bs-title=j.finished_at ? `Finished ${fmtDate(j.finished_at)}` : null)= j.duration_sec != null ? fmtDuration(j.duration_sec * 1000) : '—'
          if canManage
            td.text-end
              if j.active
                form.d-inline(
                  method="post"
                  action=`/jobs/${j.id}/cancel`
                  data-confirm=`Cancel job ${j.id}? It ends as CANCELED; if it's running, its Client stops it.`
                  data-confirm-title="Cancel job?"
                  data-confirm-ok="Cancel job"
                  data-confirm-dismiss="Keep it"
                )
                  input(type="hidden" name="returnTo" value=returnTo)
                  button.btn.btn-sm.btn-outline-danger(type="submit" aria-label="Cancel" data-bs-toggle="tooltip" data-bs-title="Cancel this job")
                    i.bi.bi-x-circle

  if canManage
    +confirmModal({
      id: 'reset-queue-modal',
      tone: 'warning',
      icon: 'bi-exclamation-triangle-fill',
      title: 'Reset the job queue?',
      action: '/jobs/reset-queue',
      confirmLabel: 'Cancel all active jobs',
      confirmIcon: 'bi-x-octagon',
      disabled: !jobCounts.active
    })
      if jobCounts.active
        p
          | This cancels
          |
          strong= `${jobCounts.active} active job${jobCounts.active === 1 ? '' : 's'}`
          |  — everything queued, assigned, preparing or running. Running jobs are stopped on their Clients, and all of them end as
          |
          code CANCELED
          | .
        p.small.text-body-secondary.mb-0 Finished jobs, logs and artifacts are not touched.
      else
        p.mb-0 There are no active jobs — nothing to cancel.

    +confirmModal({
      id: 'clean-history-modal',
      formId: 'cleanup-form',
      tone: 'danger',
      icon: 'bi-trash3-fill',
      title: 'Clean up the database?',
      action: '/jobs/clean-history',
      confirmLabel: 'Delete and compact',
      confirmIcon: 'bi-trash3'
    })
      p.small.text-body-secondary
        | Database size:
        |
        strong= cleanupInfo.size
        | . Finished jobs:
        |
        strong= jobCounts.finished
        if cleanupInfo.oldestFinished
          |  (oldest from #{cleanupInfo.oldestFinished})
        | .
      label.form-label(for="cleanup-before") Delete everything before
      input.form-control#cleanup-before(
        type="text"
        name="before"
        form="cleanup-form"
        value=cleanupInfo.now
        required
        pattern="\\s*\\d{1,2}/\\d{1,2}/\\d{4}( +\\d{1,2}:\\d{2}(:\\d{2})?)?\\s*"
        placeholder="dd/mm/yyyy HH:MM:SS"
        aria-describedby="cleanup-before-help"
      )
      .form-text#cleanup-before-help
        | dd/mm/yyyy HH:MM:SS, 24-hour, in your time zone (#{userTimeZone}).
      .d-flex.flex-wrap.gap-1.mt-2.mb-3
        each preset in cleanupInfo.presets
          button.btn.btn-sm.btn-outline-secondary(
            type="button"
            data-value=preset.value
            onclick="document.getElementById('cleanup-before').value = this.dataset.value"
          )= preset.label
      p
        | Deletes finished jobs that ended before then, with their logs and artifacts (files too), and the resource, agent and group history logged before then — then compacts the database file.
        |
        strong This cannot be undone.
        |  Active jobs are never touched.
      p.small.text-body-secondary.mb-0
        i.bi.bi-clock-history.me-1
        if cleanupInfo.retention === 'forever'
          | Automatic cleanup is off: finished jobs are kept indefinitely. Set
          |
          code retention.jobRetention
          |  in coordinator.json (1w, 2w, 1m, 3m, 6m) to wipe older ones every hour.
        else
          | Automatic cleanup: finished jobs are kept for #{cleanupInfo.retentionLabel} (
          code retention.jobRetention
          | ) and older ones are wiped every hour.
