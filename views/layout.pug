doctype html
html(lang="en" data-bs-theme=(user && user.theme) || "auto")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} · TestHub` : 'TestHub'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/thub.css")
  body
    nav.navbar.navbar-expand-lg.bg-body-tertiary.border-bottom
      .container-fluid
        a.navbar-brand(href="/") TestHub
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#nav")
          span.navbar-toggler-icon
        #nav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            if user
              li.nav-item
                a.nav-link(href="/" class=active === 'overview' ? 'active' : '') Overview
              li.nav-item
                a.nav-link(href="/resources" class=active === 'resources' ? 'active' : '') Resources
              li.nav-item
                a.nav-link(href="/groups" class=active === 'groups' ? 'active' : '') Groups
              li.nav-item
                a.nav-link(href="/jobs" class=active === 'jobs' ? 'active' : '') Jobs
              if user.role === 'admin'
                li.nav-item
                  a.nav-link(href="/admin/agents" class=active === 'agents' ? 'active' : '') Agents
          ul.navbar-nav
            li.nav-item.d-flex.align-items-center.me-3
              button#theme-toggle.btn.btn-sm.btn-outline-secondary(
                type="button"
                aria-label="Toggle theme"
                data-bs-toggle="tooltip"
                data-bs-placement="bottom"
                data-bs-title="Switch between light and dark theme"
              )
                i.bi.bi-circle-half
            if user
              li.nav-item.d-flex.align-items-center.me-3
                a.nav-link.d-flex.align-items-center.p-0(
                  href="/profile"
                  data-bs-toggle="tooltip"
                  data-bs-placement="bottom"
                  data-bs-title=`Profile settings (${user.role})`
                )
                  if user.avatarPath
                    img.rounded-circle.me-2(src=user.avatarPath width="24" height="24" style="object-fit: cover;")
                  else
                    span.rounded-circle.bg-secondary.text-white.d-inline-flex.align-items-center.justify-content-center.me-2(style="width: 24px; height: 24px; font-size: 12px;")
                      = ((user.firstName ? user.firstName[0] : user.username[0]) + (user.lastName ? user.lastName[0] : '')).toUpperCase()
                  span= user.firstName ? `${user.firstName} ${user.lastName || ''}`.trim() : user.username
              li.nav-item.d-flex.align-items-center
                form(action="/logout" method="post")
                  button.btn.btn-sm.btn-outline-danger(
                    type="submit"
                    aria-label="Log out"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    data-bs-title="Sign out of the dashboard"
                  )
                    i.bi.bi-box-arrow-right
    main.container.py-4
      if messages && messages.length
        each m in messages
          .alert(class=`alert-${m.type || 'info'}`)= m.text
      block content
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/theme.js")
    script(src="/js/tooltips.js")
    script(src="/js/copy-to-clipboard.js")
    block scripts
