doctype html
html(lang="en" data-bs-theme=(user && user.theme) || "auto")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} · TestHub` : 'TestHub'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/thub.css")
  body
    nav.navbar.navbar-expand-lg.bg-body-tertiary.border-bottom
      .container-fluid
        a.navbar-brand.d-flex.flex-column.lh-1.py-1(href="/")
          span TestHub
          small.text-body-secondary.fw-normal.mt-1(
            style="font-size: .7rem;"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            data-bs-title=`Coordinator v${coordinatorVersion} · thub-common v${commonVersion} (validates job specs)`
          )
            | ver. #{coordinatorVersion}
            if user && user.role !== 'admin' && updates.coordinatorUpdate
              span.badge.text-bg-warning.ms-1(
                data-bs-toggle="tooltip"
                data-bs-placement="bottom"
                data-bs-title="An admin can update the Coordinator from the navbar"
              )= `v${updates.coordinatorUpdate} available`
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#nav")
          span.navbar-toggler-icon
        #nav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            if user
              li.nav-item
                a.nav-link(href="/" class=active === 'overview' ? 'active' : '') Overview
              li.nav-item
                a.nav-link(href="/resources" class=active === 'resources' ? 'active' : '') Resources
              li.nav-item
                a.nav-link(href="/groups" class=active === 'groups' ? 'active' : '') Groups
              li.nav-item
                a.nav-link(href="/jobs" class=active === 'jobs' ? 'active' : '') Jobs
              if user.role === 'admin'
                li.nav-item
                  a.nav-link(href="/admin/agents" class=active === 'agents' ? 'active' : '') Agents
          ul.navbar-nav
            if user
              li.nav-item.d-flex.align-items-center.me-2
                a.nav-link.d-flex.align-items-center(
                  href="/help"
                  class=active === 'help' ? 'active' : ''
                  aria-current=active === 'help' ? 'page' : false
                  data-bs-toggle="tooltip"
                  data-bs-placement="bottom"
                  data-bs-title="Product guide, setup and CLI reference"
                )
                  i.bi.bi-question-circle.me-1
                  | Help
            if user && user.role === 'admin'
              li.nav-item.d-flex.align-items-center.me-2
                form(method="post" action="/updates/check" onsubmit="this.querySelector('button').disabled = true; this.querySelector('i').className = 'spinner-border spinner-border-sm';")
                  input(type="hidden" name="returnTo" value=currentPath)
                  button.btn.btn-sm.btn-outline-secondary(
                    type="submit"
                    aria-label="Check for updates"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    data-bs-title=updates.checkedAt ? `Check for updates now — the Coordinator and connected resources (last checked ${fmtDate(updates.checkedAt)})` : 'Check for updates now — the Coordinator and connected resources'
                  )
                    i.bi.bi-arrow-repeat
            if user && user.role === 'admin' && updates.coordinatorUpdate
              li.nav-item.d-flex.align-items-center.me-3
                if updates.coordinatorPending
                  //- public/js/update-watch.js polls /updates/status and
                  //- reloads the page once the new version is up (or the
                  //- update failed, to show why).
                  button.btn.btn-sm.btn-warning#coordinator-update-pending(
                    type="button"
                    disabled
                    data-current-version=coordinatorVersion
                  )
                    span.spinner-border.spinner-border-sm.me-1(aria-hidden="true")
                    = `Updating app to ${updates.coordinatorPending}…`
                else
                  form(
                    method="post"
                    action="/updates/coordinator"
                    data-confirm=`Update the Coordinator to v${updates.coordinatorUpdate}? It restarts, so the dashboard and API are briefly unavailable — this page reloads by itself once it's back.`
                    data-confirm-title="Update the Coordinator?"
                    data-confirm-ok="Update and restart"
                    data-confirm-tone="warning"
                  )
                    input(type="hidden" name="returnTo" value=currentPath)
                    button.btn.btn-sm.btn-warning(
                      type="submit"
                      data-bs-toggle="tooltip"
                      data-bs-placement="bottom"
                      data-bs-title=`Installed v${coordinatorVersion} — installs v${updates.coordinatorUpdate} and restarts the Coordinator`
                    )
                      i.bi.bi-cloud-download.me-1
                      = `Update app to ${updates.coordinatorUpdate}`
            li.nav-item.d-flex.align-items-center.me-3
              button#theme-toggle.btn.btn-sm.btn-outline-secondary(
                type="button"
                aria-label="Toggle theme"
                data-bs-toggle="tooltip"
                data-bs-placement="bottom"
                data-bs-title="Switch between light and dark theme"
              )
                i.bi.bi-circle-half
            if user
              li.nav-item.d-flex.align-items-center.me-3
                a.nav-link.d-flex.align-items-center.p-0(
                  href="/profile"
                  data-bs-toggle="tooltip"
                  data-bs-placement="bottom"
                  data-bs-title=`Profile settings (${user.role})`
                )
                  if user.avatarPath
                    img.rounded-circle.me-2(src=user.avatarPath width="24" height="24" style="object-fit: cover;")
                  else
                    span.rounded-circle.bg-secondary.text-white.d-inline-flex.align-items-center.justify-content-center.me-2(style="width: 24px; height: 24px; font-size: 12px;")
                      = ((user.firstName ? user.firstName[0] : user.username[0]) + (user.lastName ? user.lastName[0] : '')).toUpperCase()
                  span= user.firstName ? `${user.firstName} ${user.lastName || ''}`.trim() : user.username
              li.nav-item.d-flex.align-items-center
                form(action="/logout" method="post")
                  button.btn.btn-sm.btn-outline-danger(
                    type="submit"
                    aria-label="Log out"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    data-bs-title="Sign out of the dashboard"
                  )
                    i.bi.bi-box-arrow-right
    //- Flash messages as toasts (public/js/toasts.js): errors stay until
    //- closed, warnings close after 30 s, info/success after 10 s, with a
    //- countdown bar along the bottom (paused on hover). Rendered
    //- visible (.show), so they're readable even if the script fails.
    if messages && messages.length
      .toast-container.position-fixed.end-0.p-3(style="top: 3.5rem; z-index: 1090;")
        each m in messages
          //- Error-level aliases map to danger (never auto-closes); anything
          //- else unknown is shown as info.
          - const alias = { error: 'danger', critical: 'danger', fatal: 'danger' }[m.type] || m.type
          - const type = ['danger', 'warning', 'info', 'success'].includes(alias) ? alias : 'info'
          - const icon = { danger: 'x-octagon-fill', warning: 'exclamation-triangle-fill', info: 'info-circle-fill', success: 'check-circle-fill' }[type]
          .toast.show.border-0(
            class=`text-bg-${type}`
            role=type === 'danger' ? 'alert' : 'status'
            aria-live=type === 'danger' ? 'assertive' : 'polite'
            aria-atomic="true"
            data-thub-toast=type
            data-sticky=m.sticky ? '1' : false
          )
            .d-flex
              //- Multi-line: "\n" in a message is a line break (thub.css).
              .toast-body.d-flex.align-items-start.gap-2
                i.bi.flex-shrink-0(class=`bi-${icon}`)
                span.thub-toast-text= m.text
              button.btn-close.me-2.m-auto(
                type="button"
                class=type === 'danger' || type === 'success' ? 'btn-close-white' : ''
                data-bs-dismiss="toast"
                aria-label="Close"
              )
    main.container.py-4
      block content
    //- Shared confirmation for forms with data-confirm (public/js/confirm.js)
    //- — used instead of the browser's confirm() everywhere.
    if user
      .modal.fade#thub-confirm-modal(tabindex="-1" aria-labelledby="thub-confirm-title" aria-hidden="true")
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header.text-bg-danger(data-field="header")
              h5.modal-title#thub-confirm-title(data-field="title") Are you sure?
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-body
              p.mb-0(data-field="message" style="white-space: pre-line;")
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal" data-field="dismiss") Cancel
              button.btn.btn-danger(type="button" data-field="ok") Confirm
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/theme.js")
    script(src="/js/tooltips.js")
    script(src="/js/toasts.js")
    script(src="/js/copy-to-clipboard.js")
    script(src="/js/confirm.js")
    if user && user.role === 'admin' && updates.coordinatorPending
      script(src="/js/update-watch.js")
    block scripts
