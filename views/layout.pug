doctype html
html(lang="en" data-bs-theme="auto")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= title ? `${title} · TestHub` : 'TestHub'
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/thub.css")
  body
    nav.navbar.navbar-expand-lg.bg-body-tertiary.border-bottom
      .container-fluid
        a.navbar-brand(href="/") TestHub
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#nav")
          span.navbar-toggler-icon
        #nav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            if user
              li.nav-item
                a.nav-link(href="/" class=active === 'overview' ? 'active' : '') Overview
              li.nav-item
                a.nav-link(href="/resources" class=active === 'resources' ? 'active' : '') Resources
              li.nav-item
                a.nav-link(href="/jobs" class=active === 'jobs' ? 'active' : '') Jobs
              if user.role === 'admin'
                li.nav-item
                  a.nav-link(href="/admin/agents" class=active === 'agents' ? 'active' : '') Agents
          ul.navbar-nav
            li.nav-item.d-flex.align-items-center.me-3
              button#theme-toggle.btn.btn-sm.btn-outline-secondary(type="button") Toggle theme
            if user
              li.nav-item.navbar-text.me-3= `${user.username} (${user.role})`
              li.nav-item
                form(action="/logout" method="post")
                  button.btn.btn-sm.btn-outline-danger(type="submit") Log out
    main.container.py-4
      if messages && messages.length
        each m in messages
          .alert(class=`alert-${m.type || 'info'}`)= m.text
      block content
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/theme.js")
    block scripts
