extends ../layout
include ../mixins/status-badge
include ../mixins/resource
include ../mixins/updates
include ../mixins/list-controls

block content
  h1.h4.mb-3 Resources
  .d-flex.flex-wrap.align-items-center.gap-2.mb-3
    +updatesToolbar('client', 'clients', '/resources')
  p.text-body-secondary.small: i.
    Resources register themselves — start a Client with the shared join key and it appears here. Click a resource for its details, including IP addresses.

  .d-flex.flex-wrap.align-items-center.gap-2.mb-3
    +searchForm(list.q, 'Search resources: name, label, group, status, IP…', list.urlFor({ q: '' }))
    .ms-auto
      +pageSizePicker(list)

  div(data-live="list-toolbar")
    +listToolbar(list, 'resources')

  table.table.table-hover.align-middle
    thead
      tr
        +sortHeader(list, 'name', 'Name')
        +sortHeader(list, 'type', 'Type')
        +sortHeader(list, 'version', 'Version', 'desc')
        +sortHeader(list, 'status', 'Status')
        th Labels
        th Groups
        th Busy source / reason
        +sortHeader(list, 'heartbeat', 'Last heartbeat', 'desc')
        if user.role === 'admin'
          th Actions
    tbody(data-live="rows")
      each r in resources
        tr(role="button" tabindex="0" data-resource-card=`resource-card-${r.id}`)
          td= r.name
          td.text-uppercase= r.type
          td: +versionWithUpdate(r.client_version, updates.latest.client, r.update_to, `/resources/${r.id}/update`, list.pageUrl(), true, r.activity && r.activity.state === 'update-hold')
          td: +resourceBadge(r.status, r.remove_requested_at)
          td
            each l in r.labels
              span.badge.text-bg-light.border.me-1= l
          td
            if r.group_ids.length
              each gid in r.group_ids
                span.badge.text-bg-info.me-1(data-bs-toggle="tooltip" data-bs-title=gid)= groupsById[gid] ? groupsById[gid].name : `(unknown: ${gid})`
            else
              span.text-body-secondary —
          td= r.busy_source ? `${r.busy_source}${r.busy_reason ? ' — ' + r.busy_reason : ''}` : '—'
          td= fmtDate(r.last_heartbeat_at, 'never')
          if user.role === 'admin'
            td
              +resourceActions(r, list.pageUrl())

  each r in resources
    +resourceCard(r, groupsById, list.pageUrl())

  if user && user.role === 'admin'
    +removeResourceModal()

block scripts
  script(src="/js/resource-card.js")
  script(src="/js/remove-resource.js")
  script(src="/js/client-config.js")
  script(src="/js/usb-scan.js")
  script(src="/js/usb-parse.js")
  script(src="/js/usb-import.js")
  script(src="/js/config-import.js")
