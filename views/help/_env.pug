+section('env', 'Environment variables on the Client', 'braces')
  p.
    #[code --command] runs on the Client with the service's own environment (#[code PATH], #[code HOME], …) plus three sets of
    variables. Every value is a string. A variable whose option wasn't given is #[strong unset], so use
    #[code ${VAR:-default}] in shell. A repeatable option gives one combined variable plus #[code NAME_1], #[code NAME_2], …
    (1-based, in the order given).

  h3.h6 Set by the Client: #[code THUB_*]
  -
    const thubVars = [
      ['THUB_JOB_ID', 'The job id, e.g. M-00125'],
      ['THUB_ARTIFACTS_FILE', 'Where the command may list the artifacts it published elsewhere: a JSON array of {"name", "size", "link", "timestamp"}, shown on the job page'],
      ['THUB_WORK_DIR', 'The job\'s directory (<client workDir>/<jobId>), where the command starts. Holds downloads/, the artifacts list and .docker/ (the job\'s DOCKER_CONFIG); clone into a folder of your own, e.g. src/. JUnit XML in results/ or artifacts/ gives the test counts; deleted when the job ends'],
      ['DOCKER_CONFIG', '$THUB_WORK_DIR/.docker — so a docker login stays with the job and is deleted with it (unless --env sets DOCKER_CONFIG)'],
      ['THUB_DOWNLOADS_DIR', 'Where the --download-file files are'],
      ['THUB_DOWNLOADS / THUB_DOWNLOAD_<n>', 'Local paths of the downloads: all, one per line / each one'],
      ['THUB_META_<KEY>', '--meta values; camelCase keys become SNAKE_CASE (ciJobId → THUB_META_CI_JOB_ID)'],
    ]
  .table-responsive
    table.table.table-sm.small
      tbody
        each v in thubVars
          tr
            td(style="width: 34%"): code= v[0]
            td= v[1]

  h3.h6 Job parameters: #[code JOB_*]
  p.small Each #[code thub run] option that reaches the Client, as given:
  -
    const jobVars = [
      ['JOB_TYPE', '--type', 'hw or sw'],
      ['JOB_LABEL / JOB_LABEL_<n>', '--label', 'all labels, comma-separated / each'],
      ['JOB_GROUP', '(dashboard)', 'the submitting agent\'s group, if it has one'],
      ['JOB_CLIENT', '--client', 'this Client\'s name'],
      ['JOB_USER', '(your key)', 'the submitting user\'s username, or the CI token\'s name'],
      ['JOB_COMMAND', '--command', 'the command itself'],
      ['JOB_DOWNLOAD_FILE / _<n>', '--download-file', 'the URLs (the local files are THUB_DOWNLOAD_<n>)'],
      ['JOB_SUITE', '--suite', 'as given, default when not'],
      ['JOB_ARG / JOB_ARG_<n>', '--arg', 'all, space-separated / each (also "$@")'],
      ['JOB_TIMEOUT', '--timeout', 'seconds'],
      ['JOB_PRIORITY', '--priority', '0–100'],
      ['JOB_META_<KEY>', '--meta key=value', 'the value'],
      ['<NAME>', '--env NAME=value', 'your own variables, under the names you chose']
    ]
  .table-responsive
    table.table.table-sm.small
      thead
        tr
          th Variable
          th From
          th Value
      tbody
        each v in jobVars
          tr
            td: code= v[0]
            td: code.text-nowrap= v[1]
            td= v[2]
  p.small.
    #[code --url], #[code --key], #[code --wait], #[code --detach], #[code --json] and #[code --dry-run] only affect the Agent and
    have no variable. The Client's own git commands also get #[code GIT_TERMINAL_PROMPT=0] and #[code GIT_ALLOW_PROTOCOL=http:https:ssh:git].

  h3.h6 Your own variables: #[code --env]
  ul.small
    li #[code --env NAME=value[,NAME=value]], repeatable. A comma starts a new variable only when #[code NAME=] follows it, so values may contain commas.
    li #[code --env NAME] alone takes the value from the Agent's environment. That keeps secrets off the command line, out of shell history and out of CI logs.
    li Any names except #[code THUB_*] and #[code JOB_*].
    li They're how every piece of data and every secret reaches the job: a git token for its #[code git clone], a registry password for its #[code docker login], an API key for its tests.
    li
      | Every value is treated as a secret. It's sent only to the Client running the job, shown as #[code ***] by the API,
      | #[code thub status --json] and #[code --dry-run], and wiped from the Coordinator's database when the job ends.
      | The dashboard lists only the names.
  +note('warning').
    The command's own output #[strong is] the job log, which is stored and visible on the dashboard. Never #[code echo] a
    secret, and avoid #[code set -x] in scripts that use one.

  h3.h6 Using them in your scripts
  +code('ci/test.sh (shell)').
    #!/bin/sh
    set -eu
    echo "Job $THUB_JOB_ID on $(hostname), suite ${JOB_SUITE}"

    # optional parameters with defaults
    TARGET="${TARGET:-staging}"
    BRANCH="${BRANCH:-main}"          # from --env BRANCH=…

    # every downloaded file
    printf '%s\n' "$THUB_DOWNLOADS" | while read -r f; do echo "downloaded: $f"; done

    # HW: flash through the first ST-Link, talk to the second UART
    st-flash --reset write "$THUB_DOWNLOAD_1" 0x08000000
    python3 -m pytest tests/ --uart "/dev/thub/dut2-uart" --junitxml=results/junit.xml

    # CI metadata passed with --meta ciJobId=… / --meta sha=…
    echo "CI run ${THUB_META_CI_JOB_ID:-local}, sha ${THUB_META_SHA:-unknown}"
  +code('conftest.py (Python)').
    import glob, os

    UARTS     = sorted(glob.glob("/dev/thub/dut*-uart"))                # this Client's UARTs, by udev path
    FIRMWARE  = os.environ.get("THUB_DOWNLOAD_1")
    RESULTS   = "results"                                            # in the clone (src/results), where the tests run
    API_TOKEN = os.environ["API_TOKEN"]                              # from --env API_TOKEN
  +code('Into a container: -e NAME copies a variable from the job').
    docker run --rm --user "$(id -u):$(id -g)" -v "$THUB_WORK_DIR/src:/work" -w /work \
      -e THUB_JOB_ID -e JOB_SUITE -e TARGET -e API_TOKEN \
      python:3.14 ./run-tests.sh
  +code('Submitting the job that feeds these').
    export API_TOKEN=…
    thub run --type hw --label board:nucleo-f401re \
      --download-file https://artifactory.example.com/fw-local/app/1.4.0-42/app.bin \
      --env TARGET=production,BRANCH=main --env API_TOKEN --env GH_TOKEN \
      --meta ciJobId="$GITHUB_RUN_ID" --meta sha="$GITHUB_SHA" \
      --suite smoke \
      --command 'git clone --depth 1 --branch "$BRANCH" "https://x-access-token:$GH_TOKEN@github.com/yourorg/firmware-tests.git" src && cd src &&
                 ./ci/test.sh' --wait
  p.small.text-body-secondary.mb-0.
    Tip: #[code thub run … --dry-run] lists every variable the command would get on the chosen Client, with #[code --env] values as #[code ***].
