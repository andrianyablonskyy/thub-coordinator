extends layout

block content
  h1.h4.mb-3 Profile settings

  if user.mustChangePassword
    .alert.alert-warning
      i.bi.bi-shield-exclamation.me-1
      | You signed in with a temporary password — choose your own below before using the dashboard.

  if secret
    //- Shown once (§10.3): nothing keeps it.
    .alert.alert-warning(role="alert")
      h2.h6.alert-heading
        i.bi.bi-shield-lock.me-1
        = secret.title
      .input-group.input-group-sm.mb-2
        span.input-group-text Access key
        input.form-control.font-monospace(type="text" value=secret.key readonly aria-label="Access key")
        button.btn.btn-outline-secondary(type="button" data-copy=secret.key aria-label="Copy access key")
          i.bi.bi-clipboard
      p.small.mb-0 Shown only now. Save it with #[code thub config set key …] (or use #[code THUB_KEY] / #[code --key]).

  .row
    .col-md-6
      form(method="post" action="/profile" enctype="multipart/form-data")
        .d-flex.align-items-center.mb-3
          if user.avatarPath
            img.rounded-circle.me-3(src=user.avatarPath width="64" height="64" style="object-fit: cover;")
          else
            span.rounded-circle.bg-secondary.text-white.d-inline-flex.align-items-center.justify-content-center.me-3(style="width: 64px; height: 64px; font-size: 24px;")
              = ((user.firstName ? user.firstName[0] : user.username[0]) + (user.lastName ? user.lastName[0] : '')).toUpperCase()
          div
            label.form-label.mb-1(for="avatar") Avatar
            input#avatar.form-control.form-control-sm(type="file" name="avatar" accept="image/png,image/jpeg,image/gif,image/webp")
            .form-text PNG, JPEG, GIF or WebP, up to 2MB.

        .mb-3
          label.form-label(for="username") Username
          input#username.form-control(type="text" name="username" value=user.username required)

        .mb-3
          label.form-label(for="email") Email
          input#email.form-control(type="email" name="email" value=user.email required)
          if !user.email
            .form-text.text-warning Every user needs an email — please add yours.

        .row
          .col-6.mb-3
            label.form-label(for="firstName") First name
            input#firstName.form-control(type="text" name="firstName" value=user.firstName || '')
          .col-6.mb-3
            label.form-label(for="lastName") Last name
            input#lastName.form-control(type="text" name="lastName" value=user.lastName || '')

        .mb-3
          label.form-label(for="timezone") Timezone
          select#timezone.form-select(name="timezone" required)
            each tz in timezones
              option(value=tz selected=tz === user.timezone)= tz
          .form-text Used to render every timestamp in the dashboard.

        .mb-3
          label.form-label(for="sessionTimeoutMin") Session timeout (idle)
          select#sessionTimeoutMin.form-select(name="sessionTimeoutMin" required)
            each min in sessionTimeoutOptions
              option(value=min selected=min === user.sessionTimeoutMin)= min < 60 ? `${min} minutes` : `${min / 60} hour${min === 60 ? '' : 's'}`
          .form-text You'll be signed out after this long without activity.

        button.btn.btn-primary(type="submit") Save

    .col-md-6
      .card.mb-3
        .card-body
          h6.card-subtitle.mb-2.text-body-secondary Theme
          p.small.text-body-secondary.mb-2 Synced to your account — the same on every device you sign in from.
          .btn-group(role="group" aria-label="Theme")
            each t in ['auto', 'light', 'dark']
              button.btn.btn-sm(
                type="button"
                class=user.theme === t ? 'btn-primary' : 'btn-outline-secondary'
                data-set-theme=t
              )= t.charAt(0).toUpperCase() + t.slice(1)

      //- Your access key for the Agent (§10.3); also: thub key show|rotate.
      .card.mb-3
        .card-body
          h6.card-subtitle.mb-3.text-body-secondary My access key
          if accessKey
            p.small.mb-2
              | #[code= `…${accessKey.token_hint || '????'}`] · created #{fmtDate(accessKey.token_created_at || accessKey.created_at)} · last used #{fmtDate(accessKey.last_used_at, 'never')}
          else
            p.small.text-body-secondary.mb-2 None yet — create one to use the Agent (thub).
          .d-flex.gap-2
            form(
              method="post"
              action="/profile/key"
              data-confirm=accessKey ? 'Replace your access key? The current one stops working at once — everywhere you use it.' : 'Create your access key?'
              data-confirm-title=accessKey ? 'Replace access key?' : 'Create access key?'
              data-confirm-ok=accessKey ? 'Replace key' : 'Create key'
              data-confirm-tone="primary"
            )
              button.btn.btn-sm.btn-outline-primary(type="submit")
                i.bi.bi-key.me-1
                = accessKey ? 'Replace key' : 'Create key'
            if accessKey
              form(
                method="post"
                action="/profile/key/revoke"
                data-confirm="Revoke your access key? The Agent stops working for you until you create a new one."
                data-confirm-title="Revoke access key?"
                data-confirm-ok="Revoke key"
              )
                button.btn.btn-sm.btn-outline-warning(type="submit") Revoke
          .form-text.mt-2 From the command line: #[code thub key show] and #[code thub key rotate].

      .card
        .card-body
          h6.card-subtitle.mb-3.text-body-secondary Change password
          form(method="post" action="/profile/password")
            .mb-3
              label.form-label(for="currentPassword") Current password
              input#currentPassword.form-control(type="password" name="currentPassword" autocomplete="current-password" required)
            .mb-3
              label.form-label(for="newPassword") New password
              input#newPassword.form-control(type="password" name="newPassword" autocomplete="new-password" required)
            .mb-3
              label.form-label(for="confirmPassword") Confirm new password
              input#confirmPassword.form-control(type="password" name="confirmPassword" autocomplete="new-password" required)
            button.btn.btn-primary(type="submit") Change password

block scripts
  script(src="/js/profile-theme.js")
