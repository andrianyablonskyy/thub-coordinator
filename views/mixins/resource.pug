include client-config

//- Resource actions and the resource info card (modal), shared by the
//- Overview and Resources pages. `returnTo` is the page the action forms
//- redirect back to.

//- Update isn't here: it sits next to the version (+versionWithUpdate).
mixin resourceActions(r, returnTo)
  form.d-inline(method="post" action=`/runners/${r.id}/maintenance`)
    input(type="hidden" name="enabled" value=r.status === 'MAINTENANCE' ? '0' : '1')
    input(type="hidden" name="returnTo" value=returnTo)
    if r.status === 'MAINTENANCE'
      button.btn.btn-sm.btn-outline-secondary(
        type="submit"
        aria-label="Enable"
        data-bs-toggle="tooltip"
        data-bs-title="Bring this runner back into rotation so the scheduler can assign it jobs again"
      )
        i.bi.bi-play-circle
    else
      button.btn.btn-sm.btn-outline-secondary(
        type="submit"
        aria-label="Disable"
        data-bs-toggle="tooltip"
        data-bs-title="Take this runner out of rotation for maintenance — the scheduler will skip it"
      )
        i.bi.bi-tools
  //- Credentials: admins only (§10.3).
  if can.admin
    form.d-inline.ms-1(
      method="post"
      action=`/runners/${r.id}/rotate-token`
      data-confirm=`Issue a new token for ${r.name}? Its current token stops working at once, and the Client won't reconnect until it has the new one.`
      data-confirm-title="Rotate resource token?"
      data-confirm-ok="Rotate token"
      data-confirm-tone="warning"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-warning(
        type="submit"
        aria-label="Rotate token"
        data-bs-toggle="tooltip"
        data-bs-title="Invalidate the current resource token and issue a new one — the Client won't reconnect until it has it"
      )
        i.bi.bi-arrow-repeat
  +removeResourceButton(r, returnTo)

//- Remove: a plain confirm when the resource is idle; with a running job,
//- the shared warning modal (+removeResourceModal) instead, which stops the
//- job first (stopJob=1). Disabled once a removal is already pending.
mixin removeResourceButton(r, returnTo)
  if r.remove_requested_at
    span.d-inline-block.ms-1(tabindex="0" data-bs-toggle="tooltip" data-bs-title="Removal pending — waiting for the Client to confirm its job stopped")
      button.btn.btn-sm.btn-outline-danger(type="button" disabled style="pointer-events: none;" aria-label="Remove")
        i.bi.bi-hourglass-split
  else if r.activeJob
    button.btn.btn-sm.btn-outline-danger.ms-1(
      type="button"
      aria-label="Remove"
      data-bs-toggle="tooltip"
      data-bs-title="Remove this runner from the list — it's running a job"
      data-remove-resource=r.id
      data-remove-name=r.name
      data-remove-job=r.activeJob.id
      data-remove-return=returnTo
    )
      i.bi.bi-trash
  else
    form.d-inline.ms-1(
      method="post"
      action=`/runners/${r.id}/remove`
      data-confirm=`Remove ${r.name} from the list? Its job history is kept. A Client that's still running shows up again when it restarts and re-registers.`
      data-confirm-title=`Remove ${r.name}?`
      data-confirm-ok="Remove"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-danger(
        type="submit"
        aria-label="Remove"
        data-bs-toggle="tooltip"
        data-bs-title="Remove this runner from the list"
      )
        i.bi.bi-trash

//- One per page (admins): filled in by public/js/remove-resource.js from
//- the clicked Remove button's data-remove-* attributes.
mixin removeResourceModal()
  .modal.fade#remove-resource-modal(tabindex="-1" aria-labelledby="remove-resource-title" aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.text-bg-warning
          h5.modal-title#remove-resource-title
            i.bi.bi-exclamation-triangle-fill.me-2
            | Client is running a job
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          p
            strong(data-field="name")
            |  is running job
            |
            a(data-field="job")
            | .
          p.mb-2 Removing it will:
          ul.mb-2
            li
              | stop job
              |
              strong(data-field="job-text")
              |  immediately (it ends as
              |
              code CANCELED
              | ), then
            li remove the runner as soon as its Client confirms the job stopped (at most about a minute if the Client doesn't answer).
          p.small.text-body-secondary.mb-0 Its job history is kept. A Client that's still running shows up again when it restarts and re-registers.
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Keep it
          form(method="post" data-field="form")
            input(type="hidden" name="stopJob" value="1")
            input(type="hidden" name="returnTo" data-field="return")
            button.btn.btn-danger(type="submit")
              i.bi.bi-stop-circle.me-1
              | Stop job and remove

//- One udev device line: path (or udev index / ST-Link serial), extra
//- detail, and whether the node was present when the Client registered.
mixin capDevice(d, detail)
  li
    code= d.path || (d.serial ? `serial ${d.serial}` : `index ${d.index}`)
    if detail
      span.text-body-secondary.small.ms-2= detail
    if d.present === false
      span.badge.text-bg-danger.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="The device node didn't exist when the Client registered — check the adapter and udev rules"
      ) missing

//- What the Client reported it can drive at registration (HW: udev
//- devices; SW: nothing of its own — it runs each job's DUT image).
mixin capabilitiesList(caps)
  if !caps
    span.text-body-secondary —
  else if caps.sw
    span.text-body-secondary Runs each job's own DUT image (--docker-image), 2 CPUs / 2 GB
  else if caps.hw
    - const kinds = [['stlinks', 'ST-Link'], ['uarts', 'UART'], ['usbs', 'USB']]
    - const empty = kinds.every(([k]) => !(caps.hw[k] || []).length)
    if empty
      span.text-body-secondary no devices configured
    each pair in kinds
      if (caps.hw[pair[0]] || []).length
        .small.text-body-secondary.mt-1= pair[1]
        ul.list-unstyled.mb-0.ms-2
          each d in caps.hw[pair[0]]
            +capDevice(d, pair[0] === 'uarts' && d.baudRate ? `${d.baudRate} baud` : null)
  if caps && caps.docker
    .small.text-body-secondary.mt-1 Docker
    .ms-2
      if caps.docker.available
        span= caps.docker.version ? `available (${caps.docker.version})` : 'available'
      else
        span.badge.text-bg-warning(data-bs-toggle="tooltip" data-bs-title=caps.docker.reason || 'unknown reason') not available
        span.small.text-body-secondary.ms-2 jobs can't run docker here

//- Host uptime and the Client's current task/status with its duration,
//- both from the last heartbeat. Measured up to now — or, for a Client
//- that stopped heartbeating, up to its last heartbeat.
//- `returnTo`: where the Task / status line's Cancel button redirects.
mixin uptimeRows(r, returnTo)
  - const stale = r.status === 'OUT_OF_SERVICE' && r.last_heartbeat_at
  - const ref = stale ? new Date(r.last_heartbeat_at).getTime() : Date.now()
  - const activityLabel = { idle: 'Idle', job: 'Running job', locked: 'Locked locally', 'update-hold': 'Holding for self-update', 'reboot-hold': 'Holding for scheduled reboot' }
  dt.col-sm-4 Host uptime
  dd.col-sm-8
    if r.host_booted_at
      = fmtDuration(ref - new Date(r.host_booted_at).getTime())
      span.text-body-secondary.small.ms-2= `booted ${fmtDate(r.host_booted_at)}`
      if stale
        span.text-body-secondary.small.ms-1 (at last heartbeat)
    else
      span.text-body-secondary —
  dt.col-sm-4 Task / status
  dd.col-sm-8
    if r.activity
      = activityLabel[r.activity.state] || r.activity.state
      if r.activity.jobId
        a.ms-1(href=`/jobs/${r.activity.jobId}`)= r.activity.jobId
      = ` for ${fmtDuration(ref - new Date(r.activity.since).getTime())}`
      span.text-body-secondary.small.ms-2= `since ${fmtDate(r.activity.since)}`
      if stale
        span.text-body-secondary.small.ms-1 (at last heartbeat)
    else
      span.text-body-secondary —
    if can.operate
      +cancelActivityButton(r, returnTo)

//- Scheduled host reboot (cron, in the Client host's local time): what's
//- saved, when it next fires, whether the Client has applied it, and — for
//- admins — an editor. Saved here, applied on the Client's next heartbeat.
mixin rebootScheduleRow(r, returnTo)
  - const tz = r.host_info && r.host_info.timeZone
  - const caps = r.capabilities || {}
  - const pending = (r.reboot_schedule || null) !== (r.reboot_schedule_applied || null)
  - let next = null
  - try { next = r.reboot_schedule && tz ? nextCronRun(r.reboot_schedule, new Date(), { timeZone: tz }) : null } catch (e) { next = null }
  dt.col-sm-4 Scheduled reboot
  dd.col-sm-8
    if r.reboot_schedule
      code= r.reboot_schedule
      if next
        span.text-body-secondary.small.ms-2(
          data-bs-toggle="tooltip"
          data-bs-title=`${formatDateTime(next, { timeZone: tz })} host time (${tz}); shown here in your time zone`
        )= `next ${fmtDate(next)}`
      else if !tz
        span.text-body-secondary.small.ms-2(
          data-bs-toggle="tooltip"
          data-bs-title="The Client runs it in its host's local time; this Client is too old to report its time zone"
        ) host local time
    else
      span.text-body-secondary none
    if pending
      span.badge.text-bg-warning.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="Saved — the Client applies it on its next heartbeat"
      ) not applied yet
    if caps.rebootSupported === false
      span.badge.text-bg-danger.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="This host has no reboot helper (thub-client-reboot.path), so the schedule can't reboot it — reinstall the Client as root: sudo npm i -g @andrian.yablonskyy/thub-client"
      ) can't reboot
    if can.operate
      form.d-flex.gap-1.mt-1(
        method="post"
        action=`/runners/${r.id}/reboot-schedule`
        data-confirm=`Reboot the host of ${r.name} on this schedule? It reboots the whole host — every Client instance on it. Running jobs finish first: new ones wait, for up to 2 h, and otherwise that time is skipped.`
        data-confirm-title="Schedule host reboots?"
        data-confirm-ok="Save schedule"
        data-confirm-tone="warning"
      )
        input(type="hidden" name="returnTo" value=returnTo)
        input.form-control.form-control-sm.font-monospace(
          type="text"
          name="cron"
          value=r.reboot_schedule || ''
          placeholder="30 3 * * sun"
          aria-label=`Reboot schedule for ${r.name} (cron)`
          required
        )
        button.btn.btn-sm.btn-outline-primary(type="submit" data-bs-toggle="tooltip" data-bs-title="Save this schedule — the Client applies it on its next heartbeat") Save
      if r.reboot_schedule
        form.d-inline(method="post" action=`/runners/${r.id}/reboot-schedule`)
          input(type="hidden" name="returnTo" value=returnTo)
          input(type="hidden" name="clear" value="1")
          button.btn.btn-sm.btn-link.p-0.small(type="submit" data-bs-toggle="tooltip" data-bs-title="Remove the schedule — the host isn't rebooted on a schedule any more") Clear schedule
      .form-text
        | cron: minute hour day month weekday, in the host's local time#{tz ? ` (${tz})` : ''} — e.g.
        |
        code 30 3 * * sun
        |  (Sundays 03:30) or
        |
        code 0 4 * * *
        | . Reboots the whole host.

//- Cancel the Client's current job or local lock — icon only, on the card's
//- Task / status line, and only while there's one. A self-update hold is
//- canceled from the version line instead (+versionWithUpdate).
mixin cancelActivityButton(r, returnTo)
  - const state = r.activity && r.activity.state
  - const what = r.activeJob ? `job ${r.activeJob.id}` : state === 'locked' ? 'the local lock' : state === 'reboot-hold' ? 'the scheduled reboot' : null
  if what
    form.d-inline.ms-2(
      method="post"
      action=`/runners/${r.id}/cancel-activity`
      data-confirm=`Cancel ${what} on ${r.name}?`
      data-confirm-title=`Cancel ${what}?`
      data-confirm-ok=`Cancel ${what}`
      data-confirm-dismiss="Keep it"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-danger(
        type="submit"
        aria-label=`Cancel ${what}`
        data-bs-toggle="tooltip"
        data-bs-title=`Cancel ${what}`
      )
        i.bi.bi-x-octagon

mixin resourceCard(r, groupsById, returnTo)
  - const isLoopback = (a) => /^127\./.test(a) || a === '::1' || a === 'localhost'
  - const local = ((r.host_info && r.host_info.addresses) || []).filter((a) => !isLoopback(a.address))
  - const external = r.remote_addr && !isLoopback(r.remote_addr) ? r.remote_addr : null
  .modal.fade.thub-resource-card(id=`resource-card-${r.id}` tabindex="-1" aria-labelledby=`resource-card-${r.id}-title` aria-hidden="true")
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content
        .modal-header
          h5.modal-title(id=`resource-card-${r.id}-title`)= r.name
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        //- data-config-root: where public/js/client-config.js tracks unsaved
        //- changes (⚠ on the config tabs).
        .modal-body.pt-2(data-config-root)
          //- Details: what the Client is and reports; Capabilities: what it can
          //- drive. Then its config tabs (client-config.pug; read-only for
          //- viewers), then its USB devices.
          ul.nav.nav-tabs.mb-3(role="tablist")
            li.nav-item(role="presentation")
              button.nav-link.active(
                id=`rc-${r.id}-details-tab`
                type="button"
                role="tab"
                data-bs-toggle="tab"
                data-bs-target=`#rc-${r.id}-details`
                aria-controls=`rc-${r.id}-details`
                aria-selected="true"
              ) Details
            li.nav-item(role="presentation")
              button.nav-link(
                id=`rc-${r.id}-caps-tab`
                type="button"
                role="tab"
                data-bs-toggle="tab"
                data-bs-target=`#rc-${r.id}-caps`
                aria-controls=`rc-${r.id}-caps`
                aria-selected="false"
              ) Capabilities
            +configTabItems(r)
            li.nav-item(role="presentation")
              button.nav-link(
                id=`rc-${r.id}-usb-tab`
                type="button"
                role="tab"
                data-bs-toggle="tab"
                data-bs-target=`#rc-${r.id}-usb`
                aria-controls=`rc-${r.id}-usb`
                aria-selected="false"
              ) Connected USB devices
            
          .tab-content
            .tab-pane.fade.show.active(id=`rc-${r.id}-details` role="tabpanel" aria-labelledby=`rc-${r.id}-details-tab` tabindex="0" data-live=`rc-details-${r.id}`)
              +resourceDetails(r, groupsById, returnTo, local, external)
            //- Live too: a Client that restarts reports them again.
            .tab-pane.fade(id=`rc-${r.id}-caps` role="tabpanel" aria-labelledby=`rc-${r.id}-caps-tab` tabindex="0" data-live=`rc-caps-${r.id}`)
              p.small.text-body-secondary.mb-2 What the Client reported it can drive at its last start, checked against its host.
              .resource-capabilities
                +capabilitiesList(r.capabilities)
            +configPanes(r, returnTo, groupsById)
            .tab-pane.fade.thub-usb-pane(id=`rc-${r.id}-usb` role="tabpanel" aria-labelledby=`rc-${r.id}-usb-tab` tabindex="0")
              +usbScanPane(r)

//- "Connected USB devices" (resource card tab): the Client's `lsusb`, run
//- only on Refresh (admins; public/js/usb-scan.js fetches and fills it in).
mixin usbScanPane(r)
  - const offline = r.status === 'OUT_OF_SERVICE' || !r.last_heartbeat_at
  - const scan = r.usb_scan
  //- Import to config (public/js/usb-import.js): HW Clients that report
  //- their config only; enabled once there's a scan to import from.
  - const importWhy = r.type !== 'hw' ? 'Only HW Clients have USB device lists to import into' : !(r.config_desired || r.client_config) ? noConfigReport[0].toUpperCase() + noConfigReport.slice(1) : null
  div(data-usb-scan=`/runners/${r.id}/usb-scan` data-pending=r.usb_scan_request_id ? '1' : null data-requested-at=r.usb_scan_requested_at)
    .d-flex.align-items-center.gap-2.mb-2
      if can.operate
        //- Live (public/js/live.js): a Client that comes back online gets its
        //- Refresh back without a reload. Each button sits in a tooltip
        //- wrapper, so a disabled one still says why (usb-scan.js and
        //- usb-import.js handle clicks at the document, as these get replaced).
        - const pending = Boolean(r.usb_scan_request_id)
        - const refreshWhy = pending ? 'Waiting for the Client to run lsusb -tvv (its next heartbeat)' : offline ? 'Offline — a Client can only be scanned while it\'s connected' : null
        - const importTip = 'Fill the ST-Link, UART and DUT USB tabs from this scan, for you to review and save'
        - const importOff = importWhy || (!(scan && scan.output) ? 'Nothing to import yet — press Refresh to scan the Client first' : null)
        span.d-inline-flex.gap-2(data-live=`rc-usb-actions-${r.id}`)
          span.d-inline-block(tabindex=refreshWhy ? '0' : null data-bs-toggle="tooltip" data-bs-title=refreshWhy || 'Run lsusb -tvv on the Client now — it answers on its next heartbeat' data-usb-refresh-wrap)
            button.btn.btn-sm.btn-outline-primary(type="button" data-usb-refresh=offline ? null : '' disabled=Boolean(refreshWhy) style=refreshWhy ? 'pointer-events: none;' : null)
              i.me-1(class=pending ? 'spinner-border spinner-border-sm' : 'bi bi-arrow-clockwise')
              | Refresh
          span.d-inline-block(tabindex=importOff ? '0' : null data-bs-toggle="tooltip" data-bs-title=importOff || importTip data-usb-import-wrap data-tip-enabled=importWhy ? null : importTip)
            button.btn.btn-sm.btn-outline-secondary(type="button" data-usb-import=importWhy ? null : '' disabled=Boolean(importOff) style=importOff ? 'pointer-events: none;' : null)
              i.bi.bi-box-arrow-in-down.me-1
              | Import to config
      span.small.text-body-secondary(data-usb-status)
        if scan
          = `lsusb -tvv at ${fmtDate(scan.at)}`
        else
          | Not scanned yet#{can.operate ? ' — press Refresh to run lsusb -tvv on the Client' : ''}.
    .alert.alert-danger.py-2.small(data-usb-error class=scan && scan.error ? null : 'd-none')= scan && scan.error || ''
    //- Fills the rest of the tab and scrolls inside (thub.css .thub-usb-pane).
    pre.bg-body-tertiary.p-2.rounded.small.mb-0(data-usb-output class=scan && scan.output ? null : 'd-none')= scan && scan.output || ''

//- Reboot the Client's host now (card's Actions row, icon only): confirmed first — naming the
//- job that gets canceled, if one is running — then sent with the Client's
//- next heartbeat. Disabled while it's offline or has no reboot helper.
mixin rebootButton(r, returnTo)
  - const offline = r.status === 'OUT_OF_SERVICE' || !r.last_heartbeat_at
  - const unsupported = r.capabilities && r.capabilities.rebootSupported === false
  - const why = offline ? 'Offline — a Client can only be rebooted while connected' : unsupported ? "This host has no reboot helper — reinstall the Client as root" : null
  if why
    span.d-inline-block.ms-1(tabindex="0" data-bs-toggle="tooltip" data-bs-title=`Reboot unavailable: ${why}`)
      button.btn.btn-sm.btn-outline-danger(type="button" disabled style="pointer-events: none;" aria-label="Reboot")
        i.bi.bi-power
  else
    form.d-inline.ms-1(
      method="post"
      action=`/runners/${r.id}/reboot`
      data-confirm=r.activeJob
        ? `${r.name} is running job ${r.activeJob.id}. Rebooting cancels that job (reason: user reboot request), then reboots the host on the Client's next heartbeat. Every Client instance on that host goes down with it.`
        : `Reboot the host of ${r.name}? It reboots on the Client's next heartbeat, once nothing on the host is busy. Every Client instance on that host goes down with it.`
      data-confirm-title=r.activeJob ? `Cancel job ${r.activeJob.id} and reboot?` : `Reboot ${r.name}?`
      data-confirm-ok=r.activeJob ? 'Cancel job and reboot' : 'Reboot'
      data-confirm-dismiss="Don't reboot"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-danger(
        type="submit"
        aria-label=`Reboot ${r.name}'s host`
        data-bs-toggle="tooltip"
        data-bs-title=r.activeJob ? `Reboot the host (cancels running job ${r.activeJob.id})` : 'Reboot the host'
      )
        i.bi.bi-power

//- Export / Import the Client's config file as JSON (card's Actions row,
//- icons only). Import: public/js/config-import.js reads the chosen file
//- into the form and submits it (confirmed first); the Client applies it on
//- its next heartbeat. What it can apply: r.config_support (registry.js) —
//- a whole file, or an older HW Client's devices only.
mixin configTransferButtons(r, returnTo)
  a.btn.btn-sm.btn-outline-secondary.ms-1(
    href=`/runners/${r.id}/config/export`
    download
    aria-label=`Export ${r.name}'s config`
    data-bs-toggle="tooltip"
    data-bs-title="Export the Client's config file (JSON; its secrets left out)"
  )
    i.bi.bi-download
  if !r.config_support
    span.d-inline-block.ms-1(tabindex="0" data-bs-toggle="tooltip" data-bs-title="Import unavailable: this Client is too old to apply a config from the dashboard — update it")
      button.btn.btn-sm.btn-outline-secondary(type="button" disabled style="pointer-events: none;" aria-label="Import config")
        i.bi.bi-upload
  else
    form.d-inline.ms-1(
      method="post"
      action=`/runners/${r.id}/config/import`
      data-config-import
      data-resource-name=r.name
      data-confirm-title=`Import config into ${r.name}?`
      data-confirm-ok="Import"
      data-confirm-tone="primary"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      input(type="hidden" name="file")
      input(type="hidden" name="fileName")
      input.d-none(type="file" accept=".json,application/json" data-config-import-file)
      button.btn.btn-sm.btn-outline-secondary(
        type="button"
        aria-label=`Import a config into ${r.name}`
        data-config-import-pick
        data-bs-toggle="tooltip"
        data-bs-title=r.config_support === 'file' ? 'Import a config file (JSON) — joinKey, coordinatorUrl and name in it are ignored' : 'Import a config file (JSON) — this Client is older: only its hw-devices are applied (update it for the rest)'
      )
        i.bi.bi-upload

//- The resource card's Details tab.
mixin resourceDetails(r, groupsById, returnTo, local, external)
  dl.row.mb-0
    dt.col-sm-4 Name
    dd.col-sm-8
      span= r.name
      if r.name_override && r.reported_name
        span.text-body-secondary.small.ms-2(
          data-bs-toggle="tooltip"
          data-bs-title="Renamed on the dashboard; this is the name the Client itself reports"
        )= `(Client: ${r.reported_name})`
      if can.operate
        button.btn.btn-sm.btn-link.p-0.ms-2.align-baseline(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target=`#rename-${r.id}`
          aria-expanded="false"
          aria-controls=`rename-${r.id}`
          aria-label=`Rename ${r.name}`
        )
          i.bi.bi-pencil(data-bs-toggle="tooltip" data-bs-title="Rename")
        .collapse(id=`rename-${r.id}`)
          form.d-flex.gap-1.mt-1(method="post" action=`/runners/${r.id}/rename`)
            input(type="hidden" name="returnTo" value=returnTo)
            input.form-control.form-control-sm(
              name="name"
              value=r.name
              maxlength="64"
              pattern="[A-Za-z0-9._@+\-]*"
              placeholder=r.reported_name || ''
              aria-label=`New name for ${r.name}`
            )
            button.btn.btn-sm.btn-primary(type="submit" data-bs-toggle="tooltip" data-bs-title="Save the new name — kept across the Client's restarts") Rename
          .form-text Kept across the Client's restarts. Empty = back to the Client's own name#{r.reported_name ? ` (${r.reported_name})` : ''}.
    dt.col-sm-4 Type
    dd.col-sm-8.text-uppercase= r.type
    dt.col-sm-4 Status
    dd.col-sm-8: +resourceBadge(r.status, r.remove_requested_at)
    +uptimeRows(r, returnTo)
    dt.col-sm-4 Client version
    dd.col-sm-8: +versionWithUpdate(r.client_version, updates.latest.client, r.update_to, `/runners/${r.id}/update`, returnTo, true, r.activity && r.activity.state === 'update-hold')
    dt.col-sm-4 IP addresses
    dd.col-sm-8
      if !local.length && !external
        span.text-body-secondary —
      ul.list-unstyled.mb-0
        each a in local
          li
            code= a.address
            span.text-body-secondary.small.ms-2= a.iface ? `${a.iface} · ${a.family}` : a.family
        if external
          li
            code= external
            span.text-body-secondary.small.ms-2(
              data-bs-toggle="tooltip"
              data-bs-title="The address the Coordinator last saw this Client connect from"
            ) external
    dt.col-sm-4 Labels
    dd.col-sm-8
      if r.labels.length
        //- One label per line, as on the Labels tab.
        .d-flex.flex-column.align-items-start.gap-1
          each l in r.labels
            span.badge.text-bg-light.border.font-monospace= l
      else
        span.text-body-secondary —
    dt.col-sm-4 Busy source / reason
    dd.col-sm-8= r.busy_source ? `${r.busy_source}${r.busy_reason ? ' — ' + r.busy_reason : ''}` : '—'
    dt.col-sm-4 Last heartbeat
    dd.col-sm-8= fmtDate(r.last_heartbeat_at, 'never')
    if can.operate
      dt.col-sm-4 Actions
      dd.col-sm-8.mb-0
        +resourceActions(r, returnTo)
        +rebootButton(r, returnTo)
        +configTransferButtons(r, returnTo)
