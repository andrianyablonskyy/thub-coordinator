//- Resource actions and the resource info card (modal), shared by the
//- Overview and Resources pages. `returnTo` is the page the action forms
//- redirect back to.

//- Update isn't here: it sits next to the version (+versionWithUpdate).
mixin resourceActions(r, returnTo)
  form.d-inline(method="post" action=`/resources/${r.id}/maintenance`)
    input(type="hidden" name="enabled" value=r.status === 'MAINTENANCE' ? '0' : '1')
    input(type="hidden" name="returnTo" value=returnTo)
    if r.status === 'MAINTENANCE'
      button.btn.btn-sm.btn-outline-secondary(
        type="submit"
        aria-label="Enable"
        data-bs-toggle="tooltip"
        data-bs-title="Bring this resource back into rotation so the scheduler can assign it jobs again"
      )
        i.bi.bi-play-circle
    else
      button.btn.btn-sm.btn-outline-secondary(
        type="submit"
        aria-label="Disable"
        data-bs-toggle="tooltip"
        data-bs-title="Take this resource out of rotation for maintenance — the scheduler will skip it"
      )
        i.bi.bi-tools
  form.d-inline.ms-1(
    method="post"
    action=`/resources/${r.id}/rotate-token`
    data-confirm=`Issue a new token for ${r.name}? Its current token stops working at once, and the Client won't reconnect until it has the new one.`
    data-confirm-title="Rotate resource token?"
    data-confirm-ok="Rotate token"
    data-confirm-tone="warning"
  )
    input(type="hidden" name="returnTo" value=returnTo)
    button.btn.btn-sm.btn-outline-warning(
      type="submit"
      aria-label="Rotate token"
      data-bs-toggle="tooltip"
      data-bs-title="Invalidate the current resource token and issue a new one — the Client won't reconnect until it has it"
    )
      i.bi.bi-arrow-repeat
  +removeResourceButton(r, returnTo)

//- Remove: a plain confirm when the resource is idle; with a running job,
//- the shared warning modal (+removeResourceModal) instead, which stops the
//- job first (stopJob=1). Disabled once a removal is already pending.
mixin removeResourceButton(r, returnTo)
  if r.remove_requested_at
    span.d-inline-block.ms-1(tabindex="0" data-bs-toggle="tooltip" data-bs-title="Removal pending — waiting for the Client to confirm its job stopped")
      button.btn.btn-sm.btn-outline-danger(type="button" disabled style="pointer-events: none;" aria-label="Remove")
        i.bi.bi-hourglass-split
  else if r.activeJob
    button.btn.btn-sm.btn-outline-danger.ms-1(
      type="button"
      aria-label="Remove"
      data-bs-toggle="tooltip"
      data-bs-title="Remove this resource from the list — it's running a job"
      data-remove-resource=r.id
      data-remove-name=r.name
      data-remove-job=r.activeJob.id
      data-remove-return=returnTo
    )
      i.bi.bi-trash
  else
    form.d-inline.ms-1(
      method="post"
      action=`/resources/${r.id}/remove`
      data-confirm=`Remove ${r.name} from the list? Its job history is kept. A Client that's still running shows up again when it restarts and re-registers.`
      data-confirm-title=`Remove ${r.name}?`
      data-confirm-ok="Remove"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-danger(
        type="submit"
        aria-label="Remove"
        data-bs-toggle="tooltip"
        data-bs-title="Remove this resource from the list"
      )
        i.bi.bi-trash

//- One per page (admins): filled in by public/js/remove-resource.js from
//- the clicked Remove button's data-remove-* attributes.
mixin removeResourceModal()
  .modal.fade#remove-resource-modal(tabindex="-1" aria-labelledby="remove-resource-title" aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header.text-bg-warning
          h5.modal-title#remove-resource-title
            i.bi.bi-exclamation-triangle-fill.me-2
            | Client is running a job
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          p
            strong(data-field="name")
            |  is running job
            |
            a(data-field="job")
            | .
          p.mb-2 Removing it will:
          ul.mb-2
            li
              | stop job
              |
              strong(data-field="job-text")
              |  immediately (it ends as
              |
              code CANCELED
              | ), then
            li remove the resource as soon as its Client confirms the job stopped (at most about a minute if the Client doesn't answer).
          p.small.text-body-secondary.mb-0 Its job history is kept. A Client that's still running shows up again when it restarts and re-registers.
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Keep it
          form(method="post" data-field="form")
            input(type="hidden" name="stopJob" value="1")
            input(type="hidden" name="returnTo" data-field="return")
            button.btn.btn-danger(type="submit")
              i.bi.bi-stop-circle.me-1
              | Stop job and remove

//- One udev device line: path (or udev index / ST-Link serial), extra
//- detail, and whether the node was present when the Client registered.
mixin capDevice(d, detail)
  li
    code= d.path || (d.serial ? `serial ${d.serial}` : `index ${d.index}`)
    if detail
      span.text-body-secondary.small.ms-2= detail
    if d.present === false
      span.badge.text-bg-danger.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="The device node didn't exist when the Client registered — check the adapter and udev rules"
      ) missing

//- What the Client reported it can drive at registration (HW: udev
//- devices, relays, power; SW: emulator image and limits).
mixin capabilitiesList(caps)
  if !caps
    span.text-body-secondary —
  else if caps.sw
    ul.list-unstyled.mb-0
      li
        span.text-body-secondary.small.me-2 Image
        code= caps.sw.image || '—'
      li
        span.text-body-secondary.small.me-2 Source
        = caps.sw.registry ? caps.sw.registry : 'no local registry'
        = caps.sw.allowDockerHub ? ', then Docker Hub' : ' (Docker Hub off)'
      li
        span.text-body-secondary.small.me-2 Limits
        = `${caps.sw.cpus || '—'} CPU, ${caps.sw.memory || '—'}`
  else if caps.hw
    - const kinds = [['stlinks', 'ST-Link'], ['uarts', 'UART'], ['usbs', 'USB']]
    - const empty = kinds.every(([k]) => !caps.hw[k].length) && !caps.hw.relays.length && !caps.hw.power
    if empty
      span.text-body-secondary no devices configured
    each pair in kinds
      if caps.hw[pair[0]].length
        .small.text-body-secondary.mt-1= pair[1]
        ul.list-unstyled.mb-0.ms-2
          each d in caps.hw[pair[0]]
            +capDevice(d, pair[0] === 'uarts' && d.baudRate ? `${d.baudRate} baud` : null)
    if caps.hw.relays.length
      .small.text-body-secondary.mt-1 Relays
      ul.list-unstyled.mb-0.ms-2
        each rl in caps.hw.relays
          li
            = `channel ${rl.channel}`
            if rl.baseUrl
              code.ms-2= rl.baseUrl
    if caps.hw.power
      .small.text-body-secondary.mt-1 Power
      .ms-2
        = caps.hw.power.method
        if caps.hw.power.method === 'uhubctl' && caps.hw.power.hub
          span.text-body-secondary.small.ms-2= `hub ${caps.hw.power.hub} port ${caps.hw.power.port}`

//- Host uptime and the Client's current task/status with its duration,
//- both from the last heartbeat. Measured up to now — or, for a Client
//- that stopped heartbeating, up to its last heartbeat.
//- `returnTo`: where the Task / status line's Cancel button redirects.
mixin uptimeRows(r, returnTo)
  - const stale = r.status === 'OUT_OF_SERVICE' && r.last_heartbeat_at
  - const ref = stale ? new Date(r.last_heartbeat_at).getTime() : Date.now()
  - const activityLabel = { idle: 'Idle', job: 'Running job', locked: 'Locked locally', 'update-hold': 'Holding for self-update', 'reboot-hold': 'Holding for scheduled reboot' }
  dt.col-sm-4 Host uptime
  dd.col-sm-8
    if r.host_booted_at
      = fmtDuration(ref - new Date(r.host_booted_at).getTime())
      span.text-body-secondary.small.ms-2= `booted ${fmtDate(r.host_booted_at)}`
      if stale
        span.text-body-secondary.small.ms-1 (at last heartbeat)
    else
      span.text-body-secondary —
  dt.col-sm-4 Task / status
  dd.col-sm-8
    if r.activity
      = activityLabel[r.activity.state] || r.activity.state
      if r.activity.jobId
        a.ms-1(href=`/jobs/${r.activity.jobId}`)= r.activity.jobId
      = ` for ${fmtDuration(ref - new Date(r.activity.since).getTime())}`
      span.text-body-secondary.small.ms-2= `since ${fmtDate(r.activity.since)}`
      if stale
        span.text-body-secondary.small.ms-1 (at last heartbeat)
    else
      span.text-body-secondary —
    if user.role === 'admin'
      +cancelActivityButton(r, returnTo)

//- Scheduled host reboot (cron, in the Client host's local time): what's
//- saved, when it next fires, whether the Client has applied it, and — for
//- admins — an editor. Saved here, applied on the Client's next heartbeat.
mixin rebootScheduleRow(r, returnTo)
  - const tz = r.host_info && r.host_info.timeZone
  - const caps = r.capabilities || {}
  - const pending = (r.reboot_schedule || null) !== (r.reboot_schedule_applied || null)
  - let next = null
  - try { next = r.reboot_schedule && tz ? nextCronRun(r.reboot_schedule, new Date(), { timeZone: tz }) : null } catch (e) { next = null }
  dt.col-sm-4 Scheduled reboot
  dd.col-sm-8
    if r.reboot_schedule
      code= r.reboot_schedule
      if next
        span.text-body-secondary.small.ms-2(
          data-bs-toggle="tooltip"
          data-bs-title=`${formatDateTime(next, { timeZone: tz })} host time (${tz}); shown here in your time zone`
        )= `next ${fmtDate(next)}`
      else if !tz
        span.text-body-secondary.small.ms-2(
          data-bs-toggle="tooltip"
          data-bs-title="The Client runs it in its host's local time; this Client is too old to report its time zone"
        ) host local time
    else
      span.text-body-secondary none
    if pending
      span.badge.text-bg-warning.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="Saved — the Client applies it on its next heartbeat"
      ) not applied yet
    if caps.rebootSupported === false
      span.badge.text-bg-danger.ms-2(
        data-bs-toggle="tooltip"
        data-bs-title="This host has no reboot helper (thub-client-reboot.path), so the schedule can't reboot it — reinstall the Client as root: sudo npm i -g @andrian.yablonskyy/thub-client"
      ) can't reboot
    if user.role === 'admin'
      form.d-flex.gap-1.mt-1(
        method="post"
        action=`/resources/${r.id}/reboot-schedule`
        data-confirm=`Reboot the host of ${r.name} on this schedule? It reboots the whole host — every Client instance on it. Running jobs finish first: new ones wait, for up to 2 h, and otherwise that time is skipped.`
        data-confirm-title="Schedule host reboots?"
        data-confirm-ok="Save schedule"
        data-confirm-tone="warning"
      )
        input(type="hidden" name="returnTo" value=returnTo)
        input.form-control.form-control-sm.font-monospace(
          type="text"
          name="cron"
          value=r.reboot_schedule || ''
          placeholder="30 3 * * sun"
          aria-label=`Reboot schedule for ${r.name} (cron)`
          required
        )
        button.btn.btn-sm.btn-outline-primary(type="submit") Save
      if r.reboot_schedule
        form.d-inline(method="post" action=`/resources/${r.id}/reboot-schedule`)
          input(type="hidden" name="returnTo" value=returnTo)
          input(type="hidden" name="clear" value="1")
          button.btn.btn-sm.btn-link.p-0.small(type="submit") Clear schedule
      .form-text
        | cron: minute hour day month weekday, in the host's local time#{tz ? ` (${tz})` : ''} — e.g.
        |
        code 30 3 * * sun
        |  (Sundays 03:30) or
        |
        code 0 4 * * *
        | . Reboots the whole host.

//- Cancel the Client's current job or local lock — icon only, on the card's
//- Task / status line, and only while there's one. A self-update hold is
//- canceled from the version line instead (+versionWithUpdate).
mixin cancelActivityButton(r, returnTo)
  - const state = r.activity && r.activity.state
  - const what = r.activeJob ? `job ${r.activeJob.id}` : state === 'locked' ? 'the local lock' : state === 'reboot-hold' ? 'the scheduled reboot' : null
  if what
    form.d-inline.ms-2(
      method="post"
      action=`/resources/${r.id}/cancel-activity`
      data-confirm=`Cancel ${what} on ${r.name}?`
      data-confirm-title=`Cancel ${what}?`
      data-confirm-ok=`Cancel ${what}`
      data-confirm-dismiss="Keep it"
    )
      input(type="hidden" name="returnTo" value=returnTo)
      button.btn.btn-sm.btn-outline-danger(
        type="submit"
        aria-label=`Cancel ${what}`
        data-bs-toggle="tooltip"
        data-bs-title=`Cancel ${what}`
      )
        i.bi.bi-x-octagon

mixin resourceCard(r, groupsById, returnTo)
  - const isLoopback = (a) => /^127\./.test(a) || a === '::1' || a === 'localhost'
  - const local = ((r.host_info && r.host_info.addresses) || []).filter((a) => !isLoopback(a.address))
  - const external = r.remote_addr && !isLoopback(r.remote_addr) ? r.remote_addr : null
  .modal.fade.thub-resource-card(id=`resource-card-${r.id}` tabindex="-1" aria-labelledby=`resource-card-${r.id}-title` aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title(id=`resource-card-${r.id}-title`)= r.name
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          dl.row.mb-0
            dt.col-sm-4 Name
            dd.col-sm-8= r.name
            dt.col-sm-4 Type
            dd.col-sm-8.text-uppercase= r.type
            dt.col-sm-4 Status
            dd.col-sm-8: +resourceBadge(r.status, r.remove_requested_at)
            +uptimeRows(r, returnTo)
            +rebootScheduleRow(r, returnTo)
            dt.col-sm-4 Client version
            dd.col-sm-8: +versionWithUpdate(r.client_version, updates.latest.client, r.update_to, `/resources/${r.id}/update`, returnTo, true, r.activity && r.activity.state === 'update-hold')
            dt.col-sm-4 IP addresses
            dd.col-sm-8
              if !local.length && !external
                span.text-body-secondary —
              ul.list-unstyled.mb-0
                each a in local
                  li
                    code= a.address
                    span.text-body-secondary.small.ms-2= a.iface ? `${a.iface} · ${a.family}` : a.family
                if external
                  li
                    code= external
                    span.text-body-secondary.small.ms-2(
                      data-bs-toggle="tooltip"
                      data-bs-title="The address the Coordinator last saw this Client connect from"
                    ) external
            dt.col-sm-4 Capabilities
            dd.col-sm-8
              +capabilitiesList(r.capabilities)
            dt.col-sm-4 Labels
            dd.col-sm-8
              if r.labels.length
                each l in r.labels
                  span.badge.text-bg-light.border.me-1= l
              else
                span.text-body-secondary —
            dt.col-sm-4 Groups
            dd.col-sm-8
              if r.group_ids.length
                each gid in r.group_ids
                  span.badge.text-bg-info.me-1(data-bs-toggle="tooltip" data-bs-title=gid)= groupsById[gid] ? groupsById[gid].name : `(unknown: ${gid})`
              else
                span.text-body-secondary —
            dt.col-sm-4 Busy source / reason
            dd.col-sm-8= r.busy_source ? `${r.busy_source}${r.busy_reason ? ' — ' + r.busy_reason : ''}` : '—'
            dt.col-sm-4 Last heartbeat
            dd.col-sm-8= fmtDate(r.last_heartbeat_at, 'never')
            if user.role === 'admin'
              dt.col-sm-4 Actions
              dd.col-sm-8.mb-0
                +resourceActions(r, returnTo)
